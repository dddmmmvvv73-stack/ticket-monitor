# Caddy: https (сертификат получает и продлевает сам) + вход по паролю → интерфейс на 127.0.0.1:5050.
# На сервере — /etc/caddy/Caddyfile; адрес и хеш пароля подставляются там, в git их нет (репозиторий публичный).
# Адрес без покупки домена: <IP через дефисы>.sslip.io (например 1-2-3-4.sslip.io) — указывает на этот IP сам.
# Хеш пароля: caddy hash-password --plaintext '<пароль>'
<адрес> {
	encode gzip
	basic_auth {
		<логин> <хеш пароля>
	}
	redir / /proto/ 302
	reverse_proxy 127.0.0.1:5050
}
