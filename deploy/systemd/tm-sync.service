[Unit]
Description=ticket-monitor: свежий код с GitHub → пополнение базы из собранных на сервере файлов (база главная, ничего не стирается)
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=oneshot
User=tm
WorkingDirectory=/opt/ticket-monitor
EnvironmentFile=/etc/ticket-monitor.env
# «-»: не удалось подтянуть код (сеть, расхождение) — база всё равно пополняется
ExecStart=-/usr/bin/git -C /opt/ticket-monitor pull -q --ff-only
ExecStart=/opt/ticket-monitor/.venv/bin/python -m db.sync
# Итоги начавшихся и снятых сеансов (архив) — по последнему снимку до начала, дальше не меняются
ExecStart=/opt/ticket-monitor/.venv/bin/python -m sales.results
TimeoutStartSec=1800
