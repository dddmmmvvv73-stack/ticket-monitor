[Unit]
Description=ticket-monitor: сбор площадок прямого сбора (vladimirkoncert, odk33) — афиши, схемы залов, продажи
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=tm
WorkingDirectory=/opt/ticket-monitor
EnvironmentFile=/etc/ticket-monitor.env
Environment=TZ=Europe/Moscow
# Свежий код и ваша разметка / площадки (config/ уходит на GitHub из приложения)
ExecStartPre=/usr/bin/git -C /opt/ticket-monitor pull -q --ff-only
ExecStart=/opt/ticket-monitor/.venv/bin/python -m competitors.collector auto
ExecStartPost=/opt/ticket-monitor/deploy/commit_data.sh Сбор
TimeoutStartSec=2400
